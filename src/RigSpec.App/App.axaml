<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RigSpec.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground" Color="#171B20"/>
          <SolidColorBrush x:Key="AppForeground" Color="#F3F6F8"/>
          <SolidColorBrush x:Key="ToolbarBackground" Color="#1C2127"/>
          <SolidColorBrush x:Key="ToolbarBorder" Color="#2E3A42"/>
          <SolidColorBrush x:Key="SidebarBackground" Color="#171B20"/>
          <SolidColorBrush x:Key="SidebarBorder" Color="#2E3A42"/>
          <SolidColorBrush x:Key="ContentBackground" Color="#12171B"/>
          <SolidColorBrush x:Key="SurfaceBackground" Color="#1E242B"/>
          <SolidColorBrush x:Key="SurfaceBorder" Color="#2E3A42"/>
          <SolidColorBrush x:Key="SectionHeaderBackground" Color="#202A33"/>
          <SolidColorBrush x:Key="StrongForeground" Color="#F7FAFC"/>
          <SolidColorBrush x:Key="MutedForeground" Color="#9AA7B4"/>
          <SolidColorBrush x:Key="SecondaryForeground" Color="#A5B1BE"/>
          <SolidColorBrush x:Key="ButtonBackground" Color="#232C35"/>
          <SolidColorBrush x:Key="ButtonForeground" Color="#F3F6F8"/>
          <SolidColorBrush x:Key="ButtonHoverBackground" Color="#2D3944"/>
          <SolidColorBrush x:Key="ChartBackground" Color="#141A1E"/>
          <SolidColorBrush x:Key="ChartBorder" Color="#2E3A42"/>
          <SolidColorBrush x:Key="ChartGrid" Color="#22313A"/>
          <SolidColorBrush x:Key="IconForeground" Color="#EDF3F8"/>
          <SolidColorBrush x:Key="AccentPrimary" Color="#F3F6F8"/>
          <SolidColorBrush x:Key="AccentSecondary" Color="#7F8FA0"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground" Color="#F4F5F7"/>
          <SolidColorBrush x:Key="AppForeground" Color="#3A3D42"/>
          <SolidColorBrush x:Key="ToolbarBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="ToolbarBorder" Color="#D5D8DD"/>
          <SolidColorBrush x:Key="SidebarBackground" Color="#F4F5F7"/>
          <SolidColorBrush x:Key="SidebarBorder" Color="#D5D8DD"/>
          <SolidColorBrush x:Key="ContentBackground" Color="#F4F5F7"/>
          <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SurfaceBorder" Color="#D5D8DD"/>
          <SolidColorBrush x:Key="SectionHeaderBackground" Color="#ECEEF1"/>
          <SolidColorBrush x:Key="StrongForeground" Color="#1E2024"/>
          <SolidColorBrush x:Key="MutedForeground" Color="#6B7078"/>
          <SolidColorBrush x:Key="SecondaryForeground" Color="#6B7078"/>
          <SolidColorBrush x:Key="ButtonBackground" Color="#ECEEF1"/>
          <SolidColorBrush x:Key="ButtonForeground" Color="#3A3D42"/>
          <SolidColorBrush x:Key="ButtonHoverBackground" Color="#D5D8DD"/>
          <SolidColorBrush x:Key="ChartBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="ChartBorder" Color="#D5D8DD"/>
          <SolidColorBrush x:Key="ChartGrid" Color="#E7E9ED"/>
          <SolidColorBrush x:Key="IconForeground" Color="#3A3D42"/>
          <SolidColorBrush x:Key="AccentPrimary" Color="#3A3D42"/>
          <SolidColorBrush x:Key="AccentSecondary" Color="#6B7078"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
      <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
    </Style>
    <Style Selector="Button.icon-btn">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
    </Style>
    <Style Selector="Button.icon-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="4,2"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </Application.Styles>
</Application>
